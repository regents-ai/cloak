+// mainnetRPCFallbacks are Tor-accessible Ethereum Mainnet JSON-RPC endpoints
+// tried in order when the configured mainnet RPC is challenged (e.g. Cloudflare
+// HTTP 403 on Tor exits) or temporarily unreachable.
+var mainnetRPCFallbacks = []string{
+	"https://eth.drpc.org",
+	"https://ethereum.public.blockpi.network/v1/rpc/public",
+	"https://rpc.mevblocker.io",
+	"https://ethereum-rpc.publicnode.com",
+}
+
+func isMainnetRPCURL(u *url.URL) bool {
+	if u == nil || u.Scheme != "https" || u.RawQuery != "" {
+		return false
+	}
+	switch u.Host {
+	case "ethereum-rpc.publicnode.com", "eth.drpc.org":
+		return u.Path == "" || u.Path == "/"
+	default:
+		return false
+	}
+}
+
 func (t httpsOnly) RoundTrip(r *http.Request) (*http.Response, error) {
 	if r.URL.Scheme != "https" || r.URL.User != nil {
 		return nil, errors.New("upstream transport requires destination HTTPS")
 	}
+	if r.Method == http.MethodPost && isMainnetRPCURL(r.URL) {
+		return t.roundTripMainnetRPC(r)
+	}
 	return t.base.RoundTrip(r)
 }
 
