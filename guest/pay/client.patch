+// Regents Cloak (guest/pay/client.patch): the conversation's Tor identity,
+// which the Mac sends with each request, travels to Complete under this key,
+// which no dialer reads. Complete puts it on the inference request's dials
+// alone; every other connection a request causes, the model policy's among
+// them, gets a fresh identity from the relay.
+type conversationKey struct{}
+
+// WithConversation carries a conversation's Tor identity to Complete.
+func WithConversation(ctx context.Context, identity string) context.Context {
+	return context.WithValue(ctx, conversationKey{}, identity)
