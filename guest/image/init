#!/bin/busybox sh
# The guest's first step: move the root off the kernel's initial ramfs onto a
# tmpfs, then run the boot (/usr/lib/cloak/boot) from there. The reference
# sandbox needs this: bubblewrap pivots into its own root, and Linux never
# pivots away from the initial ramfs. switch_root empties the ramfs as it
# moves, so the root is held once, not twice, once the boot starts.
/bin/busybox mount -t tmpfs -o mode=0755 root /newroot || { echo "cloak-guest: cannot make the root"; /bin/busybox poweroff -f; }
for entry in /* /.[!.]*; do
	case $entry in /newroot|/proc|/sys|/dev|'/.[!.]*') continue ;; esac
	/bin/busybox cp -a "$entry" /newroot/ || { echo "cloak-guest: cannot copy the root"; /bin/busybox poweroff -f; }
done
/bin/busybox mkdir -m 0755 /newroot/proc /newroot/sys /newroot/dev
exec /bin/busybox switch_root /newroot /usr/lib/cloak/boot
