#!/bin/busybox sh
# The guest's only process tree, after /init has moved the root: load vsock,
# the entropy driver and the disk's drivers, open the payment disk when the
# host attaches one and start the payer on it, start the adapter on loopback
# as its own user, the Tor port (the way out, to tor on the host; the payer
# has its own) as another, the daemon's local API as a third, run the
# daemon's rewrite checks as a fourth, then the
# agent cases (Pi in the reference sandbox as the agent user), print the
# results on the console, then serve when asked to (the door port, the
# agent's tasks and sends), and power off. No network device exists in this
# guest.
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev

# Each module after the ones it needs: the guest has no modprobe, so the
# kernel loads nothing by itself. The disk's are the disk driver,
# device-mapper and dm-crypt, AES-XTS on the CPU's AES instructions, and ext4
# with its journal and checksums.
for module in vsock vmw_vsock_virtio_transport_common vmw_vsock_virtio_transport virtio-rng \
	virtio_blk dm-mod dm-crypt xts aes-ce-cipher aes-ce-blk crc16 mbcache jbd2 crc32c_generic ext4; do
	insmod /lib/modules/$module.ko || { echo "cloak-guest: cannot load $module"; poweroff -f; }
done
ip link set lo up

# The payment disk, when the host attaches one (/dev/vda, its key in the
# boot files): opened, or made when the host says the image is new, and
# mounted for the payer alone (guest/image/pay-disk). The key's file is gone
# once the disk is open. A disk that does not open ends the guest, with the
# reason on the console.
#
# Then the payer, in a network namespace of its own, whose loopback nothing
# else in the guest shares, the agent's sandbox included: a Tor port of its
# own there, as the guest's below, then cloak-pay as the payer's user, which
# starts its companion and prints "ready" once the companion answers and it
# listens on vsock (guest/pay/zz_cloak_pay_linux.go). Its log, which holds no
# content, stays in /run/cloak. One that does not start ends the guest, with
# its log on the console. With no disk, no payer starts.
pay_pid=""
if [ -e /run/cloak/pay-disk-key ]; then
	verb=open
	[ -e /etc/cloak/pay-disk-new ] && verb=create
	/usr/lib/cloak/pay-disk $verb /dev/vda /run/cloak/pay-disk-key /var/lib/cloak-pay
	opened=$?
	rm /run/cloak/pay-disk-key
	[ $opened = 0 ] || poweroff -f
	echo "cloak-guest: payment disk open"

	mkfifo /run/cloak/pay-tor-port-ready /run/cloak/pay-ready /run/cloak/pay-ended
	{
		unshare -n sh -c '
			ip link set lo up || exit 1
			su -s /bin/sh torport -c "exec /usr/bin/cloak-port 9050" > /run/cloak/pay-tor-port-ready &
			read -r ready < /run/cloak/pay-tor-port-ready
			[ "$ready" = ready ] || exit 1
			exec su -s /bin/sh pay -c "exec /usr/bin/cloak-pay"' > /run/cloak/pay-ready 2> /run/cloak/pay.log
		echo "payer exited $?" > /run/cloak/pay-ended
	} &
	pay_pid=$!
	read -r ready < /run/cloak/pay-ready
	[ "$ready" = ready ] || { echo "cloak-guest: payer did not start"; cat /run/cloak/pay.log; poweroff -f; }
	echo "cloak-guest: payer ready"
fi

# The adapter, the Tor port and the daemon each print "ready" once they
# listen. One that exits first ends its line empty.
mkfifo /run/cloak/adapter-ready
su -s /bin/sh adapter -c 'exec /usr/bin/cloak-adapter' > /run/cloak/adapter-ready &
read -r ready < /run/cloak/adapter-ready
[ "$ready" = ready ] || { echo "cloak-guest: adapter did not start"; poweroff -f; }

mkfifo /run/cloak/tor-port-ready
su -s /bin/sh torport -c 'exec /usr/bin/cloak-port 9050' > /run/cloak/tor-port-ready &
read -r ready < /run/cloak/tor-port-ready
[ "$ready" = ready ] || { echo "cloak-guest: Tor port did not start"; poweroff -f; }

mkfifo /run/cloak/daemon-ready
su -s /bin/sh zkapi -c "exec /usr/bin/cloak-daemon $(cat /etc/cloak/model) /run/cloak/rewriter-key" \
	> /run/cloak/daemon-ready 2> /run/cloak/daemon.log &
read -r ready < /run/cloak/daemon-ready
[ "$ready" = ready ] || { echo "cloak-guest: daemon did not start"; cat /run/cloak/daemon.log; poweroff -f; }

su -s /bin/sh checker -c "exec /usr/bin/cloak-rewrite-check /etc/cloak/cases.jsonl $(cat /etc/cloak/model) /run/cloak/rewriter-key"
echo "cloak-guest: check exited $?"

mkdir -p /home/agent/workspace
chown -R agent:agent /home/agent
chmod 0700 /home/agent
/usr/bin/cloak-agent-check /etc/cloak/cases.jsonl
echo "cloak-guest: agent check exited $?"

# A guest that serves (the app's, and cloak-host --serve) then runs, until
# the host stops it: the door port as its own user, where the agent's model
# requests go, to the app's door on the Mac; the runner, which runs each of
# the owner's agent tasks in the reference sandbox as the agent user; and
# the sender as its own user, Development mode's one way to a remote model,
# out through the Tor port only. The runner or the sender ending ends the
# guest: each notes its end as one line on the pipe the boot then reads.
if [ -e /etc/cloak/serve ]; then
	# Remove test/probe binaries from the writable tmpfs before any user agent
	# sandbox runs, so a compromised tool never inherits raw vsock/routing probes.
	rm -f /usr/bin/cloak-vsock-probe /usr/bin/cloak-routing-probe /usr/bin/cloak-rewrite-check /usr/bin/cloak-agent-check

	mkfifo /run/cloak/door-port-ready /run/cloak/runner-ready /run/cloak/sender-ready /run/cloak/served
	if [ -n "$pay_pid" ]; then
		{ read -r pay_end < /run/cloak/pay-ended && echo "$pay_end" > /run/cloak/served; } &
	fi
	su -s /bin/sh door -c 'exec /usr/bin/cloak-port 8742' > /run/cloak/door-port-ready &
	read -r ready < /run/cloak/door-port-ready
	[ "$ready" = ready ] || { echo "cloak-guest: door port did not start"; poweroff -f; }

	{ /usr/bin/cloak-runner > /run/cloak/runner-ready; echo "runner exited $?" > /run/cloak/served; } &
	read -r ready < /run/cloak/runner-ready
	[ "$ready" = ready ] || { echo "cloak-guest: runner did not start"; poweroff -f; }
	echo "cloak-guest: runner ready"

	{ su -s /bin/sh sender -c 'exec /usr/bin/cloak-sender' > /run/cloak/sender-ready; echo "sender exited $?" > /run/cloak/served; } &
	read -r ready < /run/cloak/sender-ready
	[ "$ready" = ready ] || { echo "cloak-guest: sender did not start"; poweroff -f; }
	echo "cloak-guest: sender ready"
	# This process is the guest's first, so a process orphaned in the guest
	# ends here: a stopped task's sandbox leaves one, its inner bubblewrap,
	# and its end would interrupt opening the pipe, which blocks. Opened for
	# reading and writing, the pipe opens at once; a read that is interrupted
	# loses no line, and is read again.
	exec 3<> /run/cloak/served
	until read -r ended <&3; do :; done
	echo "cloak-guest: $ended"
fi
if [ -n "$pay_pid" ]; then
	# Give cloak-pay a brief chance to settle cleanly and flush before poweroff.
	pkill -TERM -x cloak-pay 2>/dev/null || true
	waited=0
	while [ "$waited" -lt 30 ] && pgrep -x cloak-pay >/dev/null 2>&1; do
		sleep 0.1
		waited=$((waited + 1))
	done
	sync
	umount /var/lib/cloak-pay 2>/dev/null || true
fi
poweroff -f
