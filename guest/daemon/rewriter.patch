+// Regents Cloak, docs/plan.md decision 6 (Sean, 12 November 2026): the text
+// to rewrite in one user turn is at most maxInputCharacters characters,
+// counted as Unicode scalar values, and each rewrite call may take
+// baseDeadline plus deadlinePerCharacter for each of them.
+const maxInputCharacters = 10_000
+const baseDeadline = 90 * time.Second
+const deadlinePerCharacter = 20 * time.Millisecond
+
+func deadline(characters int) time.Duration {
+	return baseDeadline + time.Duration(characters)*deadlinePerCharacter
+}
+
+// InputTooLongError refuses a user turn over maxInputCharacters before the
+// rewriter is called. Its message is for the person who wrote the turn.
+type InputTooLongError struct{ Characters int }
+
+func (e *InputTooLongError) Error() string {
+	return "This message is " + thousands(e.Characters) + " characters long, over the limit of " +
+		thousands(maxInputCharacters) + " characters. Shorten it and send it again."
+}
+
+func thousands(n int) string {
+	s := strconv.Itoa(n)
+	for i := len(s) - 3; i > 0; i -= 3 {
+		s = s[:i] + "," + s[i:]
+	}
+	return s
+}
+
