<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<!-- Regents Cloak's AppleScript commands (app/Sources/RegentsCloak/Scripting.swift).
     None takes text or changes a setting; none sends, spends or touches the wallet. -->
<dictionary title="Cloak Terminology">
    <suite name="Cloak Suite" code="RCLK" description="Start or pause Cloak, and show its windows.">
        <command name="start" code="RCLKstrt" description="Start Cloak, as the menu's Start does.">
            <cocoa class="CloakStartCommand"/>
        </command>
        <command name="pause" code="RCLKpaus" description="Pause Cloak, as the menu's Pause does.">
            <cocoa class="CloakPauseCommand"/>
        </command>
        <command name="show chat" code="RCLKshch" description="Show the Chat window.">
            <cocoa class="CloakShowChatCommand"/>
        </command>
        <command name="show agents" code="RCLKshag" description="Show the Agents window.">
            <cocoa class="CloakShowAgentsCommand"/>
        </command>
        <command name="show details" code="RCLKshdt" description="Show the Details window.">
            <cocoa class="CloakShowDetailsCommand"/>
        </command>
        <command name="show settings" code="RCLKshst" description="Show the Settings window.">
            <cocoa class="CloakShowSettingsCommand"/>
        </command>
    </suite>
</dictionary>
